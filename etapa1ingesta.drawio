        </mxCell>
        <mxCell id="r2_1a" parent="1" style="text;html=1;strokeColor=#1A73E8;fillColor=#F0F6FF;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;spacingLeft=8;fontSize=11;" value="• Transmisión segura desde millones de dispositivos; escala elástica&lt;br&gt;• Almacena, cifra e indexa video; reproducción en vivo y bajo demanda&lt;br&gt;• Integración con Amazon Rekognition Video, MxNet, TensorFlow, OpenCV&lt;br&gt;• &lt;b&gt;Caso Brain Power:&lt;/b&gt; Análisis de lenguaje corporal (autismo/TDAH) con Video Streams + Rekognition + Data Streams + Lambda" vertex="1">
          <mxGeometry height="95" width="430" x="2110" y="95" as="geometry" />
        </mxCell>
        <mxCell id="e_r2_1a" edge="1" parent="1" source="r2_1" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeColor=#1A73E8;endArrow=none;" target="r2_1a">
