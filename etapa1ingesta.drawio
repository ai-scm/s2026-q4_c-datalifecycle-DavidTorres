        </mxCell>
        <mxCell id="r4_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;fontColor=#4A148C;strokeColor=#8E24AA;" value="&lt;b&gt;S3 Transfer Acceleration&lt;/b&gt;" vertex="1">
          <mxGeometry height="35" width="180" x="510" y="780" as="geometry" />
        </mxCell>
        <mxCell id="e_r4_2" edge="1" parent="1" source="r4" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeWidth=2;strokeColor=#8E24AA;endArrow=none;" target="r4_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r4_2a" parent="1" style="text;html=1;strokeColor=#8E24AA;fillColor=#F8EFFB;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;spacingLeft=8;fontSize=11;" value="• Transferencias rápidas a &lt;b&gt;larga distancia (100 millas o más)&lt;/b&gt; hacia buckets S3&lt;br&gt;• Usa las &lt;b&gt;155 ubicaciones de borde (Edge Locations)&lt;/b&gt; de Amazon CloudFront con rutas optimizadas" vertex="1">
          <mxGeometry height="65" width="400" x="60" y="760" as="geometry" />
        </mxCell>
        <mxCell id="e_r4_2a" edge="1" parent="1" source="r4_2" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeColor=#8E24AA;endArrow=none;" target="r4_2a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r4_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;fontColor=#4A148C;strokeColor=#8E24AA;" value="&lt;b&gt;AWS DataSync&lt;/b&gt;" vertex="1">
          <mxGeometry height="35" width="180" x="510" y="920" as="geometry" />
        </mxCell>
        <mxCell id="e_r4_3" edge="1" parent="1" source="r4" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeWidth=2;strokeColor=#8E24AA;endArrow=none;" target="r4_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r4_3a" parent="1" style="text;html=1;strokeColor=#8E24AA;fillColor=#F8EFFB;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;spacingLeft=8;fontSize=11;" value="• Automatiza transferencia in situ hacia &lt;b&gt;Amazon S3 o EFS&lt;/b&gt; vía agente local y protocolo &lt;b&gt;NFS&lt;/b&gt;&lt;br&gt;• Hasta &lt;b&gt;10x más rápido&lt;/b&gt; que open-source; maneja cifrado, red e integridad sin escribir scripts&lt;br&gt;• Funciona sobre Direct Connect o internet (migración única o replicación recurrente)" vertex="1">
          <mxGeometry height="80" width="400" x="60" y="895" as="geometry" />
        </mxCell>
