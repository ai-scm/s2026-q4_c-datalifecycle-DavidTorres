          <mxGeometry height="35" width="180" x="510" y="650" as="geometry" />
        </mxCell>
        <mxCell id="e_r4_1" edge="1" parent="1" source="r4" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeWidth=2;strokeColor=#8E24AA;endArrow=none;" target="r4_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r4_1a" parent="1" style="text;html=1;strokeColor=#8E24AA;fillColor=#F8EFFB;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;spacingLeft=8;fontSize=11;" value="• Conexión de &lt;b&gt;red dedicada y privada&lt;/b&gt; entre instalaciones/colocación y AWS&lt;br&gt;• Omite proveedores de internet (ISP), elimina congestión, aumenta ancho de banda y reduce costos" vertex="1">
