          <mxGeometry height="35" width="180" x="1880" y="680" as="geometry" />
        </mxCell>
        <mxCell id="e_r3_1" edge="1" parent="1" source="r3" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeWidth=2;strokeColor=#0F9D58;endArrow=none;" target="r3_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r3_1a" parent="1" style="text;html=1;strokeColor=#0F9D58;fillColor=#EFFAF3;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;spacingLeft=8;fontSize=11;" value="• Hardware seguro para grandes volúmenes; cuesta &lt;b&gt;1/5 del internet de alta velocidad&lt;/b&gt;&lt;br&gt;• Copia directa desde &lt;b&gt;Hadoop (HDFS)&lt;/b&gt; sin archivo intermedio (staging)&lt;br&gt;• Uso: datos genómicos, video, imágenes, respaldos, cierre de centros de datos, cintas" vertex="1">
