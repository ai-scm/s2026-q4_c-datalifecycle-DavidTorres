          <mxGeometry height="35" width="180" x="1880" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="e_r3_3" edge="1" parent="1" source="r3" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeWidth=2;strokeColor=#0F9D58;endArrow=none;" target="r3_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r3_3a" parent="1" style="text;html=1;strokeColor=#0F9D58;fillColor=#EFFAF3;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;spacingLeft=8;fontSize=11;" value="• Transferencia a escala de &lt;b&gt;petabytes (hasta 100 PB por unidad)&lt;/b&gt;&lt;br&gt;• Contenedor reforzado de 45 pies tirado por camión semirremolque&lt;br&gt;• &lt;b&gt;Caso DigitalGlobe:&lt;/b&gt; Migró 70 PB de imágenes satelitales en semanas en lugar de meses" vertex="1">
