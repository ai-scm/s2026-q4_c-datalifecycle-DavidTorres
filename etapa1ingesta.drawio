          <mxGeometry height="35" width="180" x="1880" y="280" as="geometry" />
        </mxCell>
        <mxCell id="e_r2_2" edge="1" parent="1" source="r2" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeWidth=2;strokeColor=#1A73E8;endArrow=none;" target="r2_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r2_2a" parent="1" style="text;html=1;strokeColor=#1A73E8;fillColor=#F0F6FF;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;spacingLeft=8;fontSize=11;" value="• Masivamente escalable y durable: captura GB/seg de cientos de miles de fuentes&lt;br&gt;• Datos disponibles en &lt;b&gt;milisegundos&lt;/b&gt; (sin esperar lote completo)&lt;br&gt;• &lt;b&gt;Casos:&lt;/b&gt; Clickstreams, eventos BD, finanzas, redes sociales, logs TI, geolocalización, detección de anomalías y tarificación dinámica" vertex="1">
          <mxGeometry height="85" width="430" x="2110" y="245" as="geometry" />
        </mxCell>
        <mxCell id="e_r2_2a" edge="1" parent="1" source="r2_2" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeColor=#1A73E8;endArrow=none;" target="r2_2a">
