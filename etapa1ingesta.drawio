        <mxCell id="e_r3_2" edge="1" parent="1" source="r3" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeWidth=2;strokeColor=#0F9D58;endArrow=none;" target="r3_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r3_2a" parent="1" style="text;html=1;strokeColor=#0F9D58;fillColor=#EFFAF3;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;spacingLeft=8;fontSize=11;" value="• Almacenamiento + &lt;b&gt;Computación Perimetral&lt;/b&gt; (soporta instancias EC2 y AWS Lambda)&lt;br&gt;• &lt;b&gt;Storage Optimized:&lt;/b&gt; 100 TB capacidad + 24 vCPUs&lt;br&gt;• &lt;b&gt;Compute Optimized:&lt;/b&gt; 52 vCPUs + GPU opcional (ML y video en entornos desconectados)&lt;br&gt;• Apilable en rack; ideal para manufactura, transporte, operaciones militares/marítimas" vertex="1">
