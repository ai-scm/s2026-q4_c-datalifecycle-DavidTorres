          <mxGeometry height="35" width="180" x="510" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="e_r4_4" edge="1" parent="1" source="r4" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeWidth=2;strokeColor=#8E24AA;endArrow=none;" target="r4_4">
