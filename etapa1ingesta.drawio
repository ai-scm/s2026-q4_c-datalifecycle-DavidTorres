        </mxCell>
        <mxCell id="e_r2_3" edge="1" parent="1" source="r2" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeWidth=2;strokeColor=#1A73E8;endArrow=none;" target="r2_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r2_3a" parent="1" style="text;html=1;strokeColor=#1A73E8;fillColor=#F0F6FF;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;spacingLeft=8;fontSize=11;" value="• Forma más sencilla de cargar datos transmitidos en análisis &lt;b&gt;casi en tiempo real&lt;/b&gt;&lt;br&gt;• Destinos directos: &lt;b&gt;Amazon S3, Redshift, Elasticsearch Service y Splunk&lt;/b&gt;&lt;br&gt;• Totalmente gestionado: agrupa, comprime, transforma y cifra antes de cargar" vertex="1">
          <mxGeometry height="80" width="430" x="2110" y="390" as="geometry" />
        </mxCell>
        <mxCell id="e_r2_3a" edge="1" parent="1" source="r2_3" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeColor=#1A73E8;endArrow=none;" target="r2_3a">
