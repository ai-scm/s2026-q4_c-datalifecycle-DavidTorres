        <mxCell id="r5_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAD2CF;fontColor=#A50E0E;strokeColor=#D93025;" value="&lt;b&gt;DynamoDB y DocumentDB&lt;/b&gt;" vertex="1">
          <mxGeometry height="35" width="200" x="580" y="1470" as="geometry" />
        </mxCell>
        <mxCell id="e_r5_1" edge="1" parent="1" source="r5" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeWidth=2;strokeColor=#D93025;endArrow=none;" target="r5_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r5_1a" parent="1" style="text;html=1;strokeColor=#D93025;fillColor=#FCE8E6;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;spacingLeft=8;fontSize=11;" value="• &lt;b&gt;DynamoDB:&lt;/b&gt; Clave-valor y documentos; latencia de milisegundos de un dígito (3 AZ, +DAX caché)&lt;br&gt;• Soporta &lt;b&gt;+10 billones de solicitudes/día&lt;/b&gt; y picos de +20M req/seg (Lyft, Airbnb, Capital One)&lt;br&gt;• &lt;b&gt;DocumentDB:&lt;/b&gt; Admite documentos grandes y es compatible con &lt;b&gt;MongoDB&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Caso Healthdirect Australia:&lt;/b&gt; Arquitectura dual lectura/escritura (DynamoDB, S3, Lambda, Kinesis, Athena)" vertex="1">
          <mxGeometry height="95" width="500" x="430" y="1540" as="geometry" />
        </mxCell>
        <mxCell id="e_r5_1a" edge="1" parent="1" source="r5_1" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeColor=#D93025;endArrow=none;" target="r5_1a">
