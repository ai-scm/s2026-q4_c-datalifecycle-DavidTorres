        <mxCell id="r4_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;fontColor=#4A148C;strokeColor=#8E24AA;" value="&lt;b&gt;Amazon RDS y RDS on VMware&lt;/b&gt;" vertex="1">
          <mxGeometry height="35" width="190" x="550" y="840" as="geometry" />
        </mxCell>
        <mxCell id="e_r4_2" edge="1" parent="1" source="r4" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeWidth=2;strokeColor=#8E24AA;endArrow=none;" target="r4_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r4_2a" parent="1" style="text;html=1;strokeColor=#8E24AA;fillColor=#F8EFFB;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;spacingLeft=8;fontSize=11;" value="• Automatiza hardware, parches y respaldos; 6 motores: &lt;b&gt;Aurora, PostgreSQL, MySQL, MariaDB, Oracle y SQL Server&lt;/b&gt;&lt;br&gt;• Instancias optimizadas para memoria, rendimiento o E/S (2 AZ)&lt;br&gt;• &lt;b&gt;RDS on VMware:&lt;/b&gt; Extiende gestión RDS a centros de datos privados VMware vSphere locales" vertex="1">
          <mxGeometry height="80" width="440" x="60" y="810" as="geometry" />
        </mxCell>
        <mxCell id="e_r4_2a" edge="1" parent="1" source="r4_2" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeColor=#8E24AA;endArrow=none;" target="r4_2a">
