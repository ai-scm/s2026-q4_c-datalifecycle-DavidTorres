        <mxCell id="e_r1_2" edge="1" parent="1" source="r1" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeWidth=2;strokeColor=#FF9900;endArrow=none;" target="r1_2">
          <mxGeometry relative="1" as="geometry" />
