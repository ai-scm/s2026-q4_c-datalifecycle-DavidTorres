        </mxCell>
        <mxCell id="e_r4_3" edge="1" parent="1" source="r4" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeWidth=2;strokeColor=#8E24AA;endArrow=none;" target="r4_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r4_3a" parent="1" style="text;html=1;strokeColor=#8E24AA;fillColor=#F8EFFB;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;spacingLeft=8;fontSize=11;" value="• Caché en memoria administrado (&lt;b&gt;Hot Data&lt;/b&gt;, tamaño GB, disponibilidad 2 AZ)&lt;br&gt;• Tasas de solicitud ultra altas y latencia ultra baja (evita leer de discos lentos)" vertex="1">
          <mxGeometry height="65" width="440" x="60" y="1010" as="geometry" />
        </mxCell>
