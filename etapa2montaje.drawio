        </mxCell>
        <mxCell id="r5_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAD2CF;fontColor=#A50E0E;strokeColor=#D93025;" value="&lt;b&gt;Amazon Neptune (Grafos)&lt;/b&gt;" vertex="1">
          <mxGeometry height="35" width="180" x="1150" y="1470" as="geometry" />
        </mxCell>
        <mxCell id="e_r5_2" edge="1" parent="1" source="r5" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeWidth=2;strokeColor=#D93025;endArrow=none;" target="r5_2">
