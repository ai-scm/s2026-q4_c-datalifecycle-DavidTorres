        <mxCell id="r1_2a" parent="1" style="text;html=1;strokeColor=#FF9900;fillColor=#FFF8EE;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;spacingLeft=8;fontSize=11;" value="• &lt;b&gt;¿Casos de uso?&lt;/b&gt; No configurar un Data Warehouse si basta una BD transaccional (OLTP)&lt;br&gt;• &lt;b&gt;¿Tamaño del dataset?&lt;/b&gt; General → Amazon S3 | Muy pequeños → búfer en Kinesis Firehose&lt;br&gt;• &lt;b&gt;¿Estructura y costos?&lt;/b&gt; Define el motor de almacenamiento o base de datos ideal" vertex="1">
          <mxGeometry height="75" width="430" x="80" y="310" as="geometry" />
        </mxCell>
        <mxCell id="e_r1_2a" edge="1" parent="1" source="r1_2" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeColor=#FF9900;endArrow=none;" target="r1_2a">
