        <mxCell id="r4_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;fontColor=#4A148C;strokeColor=#8E24AA;" value="&lt;b&gt;Amazon Aurora y Serverless&lt;/b&gt;" vertex="1">
          <mxGeometry height="35" width="190" x="550" y="640" as="geometry" />
        </mxCell>
        <mxCell id="e_r4_1" edge="1" parent="1" source="r4" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeWidth=2;strokeColor=#8E24AA;endArrow=none;" target="r4_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r4_1a" parent="1" style="text;html=1;strokeColor=#8E24AA;fillColor=#F8EFFB;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;spacingLeft=8;fontSize=11;" value="• Compatible con &lt;b&gt;MySQL y PostgreSQL&lt;/b&gt;; escala hasta &lt;b&gt;64 TB&lt;/b&gt; por instancia&lt;br&gt;• Hasta &lt;b&gt;15 réplicas de lectura&lt;/b&gt;, replicación en &lt;b&gt;3 AZ&lt;/b&gt;, autorreparable y respaldo continuo a S3&lt;br&gt;• &lt;b&gt;Aurora Serverless (MySQL):&lt;/b&gt; Escala/apaga bajo demanda; pago por segundo (cargas intermitentes)" vertex="1">
          <mxGeometry height="80" width="440" x="60" y="610" as="geometry" />
        </mxCell>
        <mxCell id="e_r4_1a" edge="1" parent="1" source="r4_1" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeColor=#8E24AA;endArrow=none;" target="r4_1a">
