        </mxCell>
        <mxCell id="e_r3_1" edge="1" parent="1" source="r3" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeWidth=2;strokeColor=#0F9D58;endArrow=none;" target="r3_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r3_1a" parent="1" style="text;html=1;strokeColor=#0F9D58;fillColor=#EFFAF3;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;spacingLeft=8;fontSize=11;" value="• Almacena datos &lt;b&gt;tal como están&lt;/b&gt; (estructurados o no estructurados) sin esquema predefinido&lt;br&gt;• Desglosa silos de datos y &lt;b&gt;desacopla el almacenamiento del cómputo&lt;/b&gt; sobre Amazon S3&lt;br&gt;• Admite formatos abiertos y conecta con todos los servicios analíticos de AWS" vertex="1">
          <mxGeometry height="80" width="460" x="2240" y="610" as="geometry" />
        </mxCell>
        <mxCell id="e_r3_1a" edge="1" parent="1" source="r3_1" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeColor=#0F9D58;endArrow=none;" target="r3_1a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r3_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CEEAD6;fontColor=#0D652D;strokeColor=#0F9D58;" value="&lt;b&gt;AWS Lake Formation (5 Pasos)&lt;/b&gt;" vertex="1">
          <mxGeometry height="35" width="190" x="2010" y="830" as="geometry" />
        </mxCell>
        <mxCell id="e_r3_2" edge="1" parent="1" source="r3" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeWidth=2;strokeColor=#0F9D58;endArrow=none;" target="r3_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r3_2a" parent="1" style="text;html=1;strokeColor=#0F9D58;fillColor=#EFFAF3;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;spacingLeft=8;fontSize=11;" value="• Plantilla para configurar un lago de datos curado y seguro en días:&lt;br&gt;  &lt;b&gt;1)&lt;/b&gt; Configurar almacenamiento  &lt;b&gt;2)&lt;/b&gt; Mover datos  &lt;b&gt;3)&lt;/b&gt; Limpiar, preparar y catalogar&lt;br&gt;  &lt;b&gt;4)&lt;/b&gt; Configurar políticas de seguridad/cumplimiento  &lt;b&gt;5)&lt;/b&gt; Habilitar datos para análisis" vertex="1">
          <mxGeometry height="80" width="460" x="2240" y="800" as="geometry" />
        </mxCell>
        <mxCell id="e_r3_2a" edge="1" parent="1" source="r3_2" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeColor=#0F9D58;endArrow=none;" target="r3_2a">
