        <mxCell id="r1_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;fontColor=#232F3E;strokeColor=#FF9900;" value="&lt;b&gt;Preguntas Clave de Diseño&lt;/b&gt;" vertex="1">
