        <mxCell id="r2_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D2E3FC;fontColor=#174EA6;strokeColor=#1A73E8;" value="&lt;b&gt;Capacidades Core de S3&lt;/b&gt;" vertex="1">
          <mxGeometry height="35" width="180" x="2010" y="130" as="geometry" />
        </mxCell>
        <mxCell id="e_r2_1" edge="1" parent="1" source="r2" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeWidth=2;strokeColor=#1A73E8;endArrow=none;" target="r2_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r2_1a" parent="1" style="text;html=1;strokeColor=#1A73E8;fillColor=#F0F6FF;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;spacingLeft=8;fontSize=11;" value="• Almacenamiento de objetos: extremadamente durable, altamente disponible e infinitamente escalable&lt;br&gt;• Pago por uso sin inversión inicial; interfaz web sencilla desde cualquier lugar&lt;br&gt;• Flexibilidad total: desde respaldos/DR hasta sitios masivos como Amazon.com" vertex="1">
          <mxGeometry height="80" width="460" x="2240" y="100" as="geometry" />
        </mxCell>
        <mxCell id="e_r2_1a" edge="1" parent="1" source="r2_1" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeColor=#1A73E8;endArrow=none;" target="r2_1a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r2_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D2E3FC;fontColor=#174EA6;strokeColor=#1A73E8;" value="&lt;b&gt;Metadatos Definidos por Usuario&lt;/b&gt;" vertex="1">
          <mxGeometry height="35" width="190" x="2010" y="280" as="geometry" />
        </mxCell>
        <mxCell id="e_r2_2" edge="1" parent="1" source="r2" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeWidth=2;strokeColor=#1A73E8;endArrow=none;" target="r2_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r2_2a" parent="1" style="text;html=1;strokeColor=#1A73E8;fillColor=#F0F6FF;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;spacingLeft=8;fontSize=11;" value="• &lt;b&gt;Técnicos:&lt;/b&gt; Formato, estructura, checksum, conteo filas, fecha, tipo y tamaño de archivo&lt;br&gt;• &lt;b&gt;Operacionales:&lt;/b&gt; Fuente, frecuencia, tamaño (full/incremental), vigencia, linaje, propietario&lt;br&gt;• &lt;b&gt;De Negocio:&lt;/b&gt; Significado/contexto, clasificación, PII/PHI, llaves primarias/foráneas, dominio" vertex="1">
          <mxGeometry height="85" width="460" x="2240" y="245" as="geometry" />
        </mxCell>
        <mxCell id="e_r2_2a" edge="1" parent="1" source="r2_2" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeColor=#1A73E8;endArrow=none;" target="r2_2a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r2_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D2E3FC;fontColor=#174EA6;strokeColor=#1A73E8;" value="&lt;b&gt;S3 Object Tags + IAM&lt;/b&gt;" vertex="1">
          <mxGeometry height="35" width="180" x="2010" y="420" as="geometry" />
        </mxCell>
        <mxCell id="e_r2_3" edge="1" parent="1" source="r2" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeWidth=2;strokeColor=#1A73E8;endArrow=none;" target="r2_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r2_3a" parent="1" style="text;html=1;strokeColor=#1A73E8;fillColor=#F0F6FF;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;spacingLeft=8;fontSize=11;" value="• Pares &lt;b&gt;Clave/Valor&lt;/b&gt; externos al contenido del objeto (similar a datos EXIF en JPEG)&lt;br&gt;• Combinados con &lt;b&gt;AWS IAM&lt;/b&gt; controlan acceso granular y clasificación de seguridad&lt;br&gt;• &lt;b&gt;Ejemplos:&lt;/b&gt; Clasificación=Sensible | Caso de uso=Análisis | Proyecto=OTA | PII=Verdadero" vertex="1">
          <mxGeometry height="80" width="460" x="2240" y="390" as="geometry" />
        </mxCell>
        <mxCell id="e_r2_3a" edge="1" parent="1" source="r2_3" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeColor=#1A73E8;endArrow=none;" target="r2_3a">
