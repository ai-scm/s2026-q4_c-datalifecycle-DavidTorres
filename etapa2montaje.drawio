        </mxCell>
        <mxCell id="r5_2a" parent="1" style="text;html=1;strokeColor=#D93025;fillColor=#FCE8E6;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;spacingLeft=8;fontSize=11;" value="• Datos altamente conectados: almacena miles de millones de relaciones con latencia de milisegundos (3 AZ)&lt;br&gt;• Modelos &lt;b&gt;Property Graph y RDF (W3C)&lt;/b&gt;; consultas con &lt;b&gt;Apache TinkerPop Gremlin y SPARQL&lt;/b&gt;&lt;br&gt;• Uso: recomendación, detección de fraude, grafos de conocimiento y descubrimiento de fármacos" vertex="1">
          <mxGeometry height="85" width="480" x="1000" y="1540" as="geometry" />
        </mxCell>
        <mxCell id="e_r5_2a" edge="1" parent="1" source="r5_2" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;strokeColor=#D93025;endArrow=none;" target="r5_2a">
