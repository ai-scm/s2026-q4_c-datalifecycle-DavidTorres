        <mxCell id="r3_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CEEAD6;fontColor=#0D652D;strokeColor=#0F9D58;" value="&lt;b&gt;Arquitectura y Beneficios&lt;/b&gt;" vertex="1">
