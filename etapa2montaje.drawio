        <mxCell id="central" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=#FF9900;strokeWidth=4;fontSize=15;" value="&lt;b&gt;ETAPA 2: MONTAJE DE DATOS EN AWS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Tarea doméstica, limpieza, almacenamiento y estructuración&lt;br&gt;antes de poner los datos a disposición para análisis&lt;/font&gt;" vertex="1">
